# Local service. Register this exact redirect URI in the Twitch app console.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
CLIENT_ID=
CLIENT_SECRET=
BROADCASTER_LOGIN=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# MVP: read chat, change channel metadata, create polls and clips.
# Add scopes for the actions you enable; reauthorize after changing scopes.
# channel:manage:polls also authorizes poll EventSub subscriptions.
TWITCH_SCOPES="user:read:chat channel:manage:broadcast channel:manage:polls clips:edit"
# Optional: channel:manage:redemptions
# Optional: channel:manage:predictions moderator:manage:shoutouts
# Optional: channel:manage:ads channel:read:ads channel:manage:raids

# Parsed by the service config loader; core receives numeric config.
ROUND_WINDOW_MS=25000
QUORUM=3
COOLDOWN_MS=10000
CONFIRM_TIMEOUT_MS=8000
MIN_RATE_LIMIT_REMAINING=5
SHOUTOUT_COOLDOWN_MS=120000
SHOUTOUT_TARGET_COOLDOWN_MS=3600000
ENABLED_ACTIONS=set_title,set_category,create_poll,create_clip,create_marker
# Also supported: create_prediction,shoutout,snooze_ad,resolve_prediction,raid
# Comma-separated case-insensitive substrings rejected in audience text.
BLOCKED_TERMS=

# Opt in to creating/reusing one app-owned queued proposal reward in live mode.
ENABLE_CHANNEL_POINTS=false
REWARD_COST=100

# Runtime files are local and gitignored. OAuth stores/refreshed tokens go here.
# Blank selects ./data/demo-events.jsonl or ./data/live-events.jsonl.
EVENT_LOG_PATH=
TOKEN_STORE_PATH=./data/tokens.json

# Optional language-to-action mapper; no AI client is implemented yet.
ENABLE_AI=false

# Informational; the recorded main build thread is in README.md.
CODEX_SESSION_ID=
