{
  "name": "directors-cut",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic audience control room for a Twitch channel.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "demo": "tsx src/server/main.ts --demo",
    "live": "tsx src/server/main.ts --live",
    "start": "node dist/server/main.js",
    "start:live": "node dist/server/main.js --live",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.0.18"
  }
}
